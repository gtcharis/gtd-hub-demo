DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gtcharis.github.io
DEMO_DEFAULT_PASSWORD=Set-A-Unique-Demo-Password
# Required for secure case operations. Generate independent 32-byte keys and base64url encode them.
# Never commit real values. Keep keys in the hosting provider's secret manager, not PostgreSQL.
CASE_ENCRYPTION_KEY=
CASE_ENCRYPTION_KEY_VERSION=v1
CASE_AUDIT_HMAC_KEY=
# Set true in production behind an HTTPS-terminating reverse proxy.
REQUIRE_HTTPS=true
